{
  "name": "@local/dsh-deepseek-usage-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek API account balance and Harness-observed token usage monitor with a sidebar panel, agent tools, and alerts.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:sandbox": "node --test --test-isolation=none \"test/*.test.mjs\""
  },
  "license": "MIT"
}
